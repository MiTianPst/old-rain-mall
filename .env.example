MYSQL_DATABASE=old_rain_mall
MYSQL_USER=old_rain
MYSQL_PASSWORD=change_me
MYSQL_ROOT_PASSWORD=change_me_root
DATABASE_URL=mysql://old_rain:change_me@127.0.0.1:3306/old_rain_mall
BETTER_AUTH_SECRET=replace_with_at_least_32_random_characters
BETTER_AUTH_URL=http://localhost:3000
ORDER_EXPIRATION_JOB_SECRET=replace_with_at_least_32_random_characters
PAYMENT_PROVIDER=MOCK

# AI 客服：只在服务端配置，未填写时聊天入口会提示暂不可用
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

# QQ 邮箱找回密码邮件：使用邮箱地址和 SMTP 授权码，不要填写 QQ 登录密码
QQ_SMTP_USER=
QQ_SMTP_AUTH_CODE=

# 使用微信 Native 时改为 WECHAT_NATIVE，并填写真实商户配置（不要提交私钥）
WECHAT_APP_ID=
WECHAT_MCH_ID=
WECHAT_SERIAL_NO=
WECHAT_PRIVATE_KEY=
WECHAT_PLATFORM_CERTIFICATE=
WECHAT_API_V3_KEY=
WECHAT_NOTIFY_URL=
