MYSQL_DATABASE=old_rain_mall
MYSQL_USER=old_rain
MYSQL_PASSWORD=replace_with_a_long_random_password
MYSQL_ROOT_PASSWORD=replace_with_another_long_random_password
DATABASE_URL=mysql://old_rain:replace_with_a_long_random_password@mysql:3306/old_rain_mall
BETTER_AUTH_SECRET=replace_with_at_least_32_random_characters
BETTER_AUTH_URL=https://shop.example.com
ORDER_EXPIRATION_JOB_SECRET=replace_with_at_least_32_random_characters

# MOCK 适合本地演示；生产环境改为 WECHAT_NATIVE 并填写下面的商户配置。
PAYMENT_PROVIDER=WECHAT_NATIVE
WECHAT_APP_ID=wx_your_app_id
WECHAT_MCH_ID=your_merchant_id
WECHAT_SERIAL_NO=your_merchant_certificate_serial_no
WECHAT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace_with_merchant_private_key\n-----END PRIVATE KEY-----"
WECHAT_PLATFORM_CERTIFICATE="-----BEGIN CERTIFICATE-----\nreplace_with_wechat_platform_certificate\n-----END CERTIFICATE-----"
WECHAT_API_V3_KEY=replace_with_exactly_32_characters
WECHAT_NOTIFY_URL=https://shop.example.com/api/payments/wechat/notify

# AI 客服密钥必须作为服务端环境变量提供，禁止提交真实密钥
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

# QQ 邮箱 SMTP（仅适合低发送量；正式商用建议迁移到专用邮件服务）
QQ_SMTP_USER=
QQ_SMTP_AUTH_CODE=
