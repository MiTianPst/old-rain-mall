{
  "name": "old-rain-mall",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "test:db": "node --conditions=react-server --env-file=.env --import ./scripts/enable-db-tests.mjs --import tsx --test --test-concurrency=1 src/server/repositories/cart-repository.integration.test.ts src/server/repositories/product-variant.integration.test.ts src/server/repositories/transaction-flow.integration.test.ts src/server/repositories/shipping-after-sales.integration.test.ts src/server/repositories/users-security-operations.integration.test.ts",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx --env-file=.env src/db/seed.ts"
  },
  "dependencies": {
    "better-auth": "1.7.4",
    "drizzle-orm": "^0.45.2",
    "mysql2": "^3.24.4",
    "next": "16.3.5",
    "nodemailer": "^10.0.10",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "sharp": "^0.35.4",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  }
}
